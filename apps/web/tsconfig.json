{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  // `src/game/engine.real.ts` used to be excluded here, because `packages/engine/src/index.ts`
  // re-exported six modules that did not exist yet. `tsc -p packages/engine/tsconfig.json` is
  // green now, so the client's one engine import is typechecked like everything else.
  "include": ["src", "vite.config.ts", "vitest.config.ts"]
}
