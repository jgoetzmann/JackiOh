{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The server is the impure half of the repo: it reads the clock, opens sockets and talks to
    // Postgres. tsconfig.base.json ships `types: []` for the pure packages (SPEC §9.3), so the
    // server opts Node's globals back in.
    "types": ["node"]
  },
  // Everything under `src` compiles, `src/match/engine.real.ts` included. It was excluded while
  // `packages/engine` did not compile; `tsc -p packages/engine/tsconfig.json` now exits 0, so the
  // one file in `apps/server` that imports `@jackioh/engine` is typechecked with the rest.
  //
  // The dynamic import in `src/match/engine.ts` stays, and that file says why: a static import
  // would load the engine and `packages/cards`' 109 scripts into every process that touches the
  // server — tests with an injected port included — and would turn "the engine could not be
  // loaded" from an `EngineUnavailableError` into a module-graph failure with no diagnostic.
  "include": ["src", "test", "vitest.config.ts"]
}
