# JackiOh server environment. Copy to apps/server/.env and fill in.
# Every variable here is SERVER-ONLY: it must never reach a browser bundle.
# The public half of the contract lives in apps/web/.env.example (VITE_* names).
# Full contract with sources: docs/architecture.md, "Env-var contract".

# --- Supabase project -------------------------------------------------------
# Dashboard -> Project Settings -> Data API -> Project URL.
# Local: http://127.0.0.1:54321 (printed by `supabase start`).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...).
# Maps to the Postgres `service_role` and BYPASSES EVERY RLS POLICY. Never in a client,
# never in git, never with a VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Used for the transactions the Data API cannot express: the six-step invite redemption (§9.4),
# saveLoadout's all-or-nothing write (§9.4) and the atomic ticket claim (§9.5).
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# The server verifies a browser's Supabase Auth JWT against this JWKS and trusts only the
# verified `sub` as the profile id (§9.1: the client sends intent, never identity).
# SUPABASE_JWKS_URL=

# Optional legacy HS256 fallback. Discouraged; prefer asymmetric keys and the JWKS above.
# SUPABASE_JWT_SECRET=

# --- Secrets this project owns ---------------------------------------------
# HMAC pepper for invite_codes.code_hash and code_attempts.ip_hash (§9.4: codes are stored
# hashed). Generate with: openssl rand -base64 48
# Rotating it invalidates every unredeemed code, by design.
CODE_PEPPER=REPLACE_ME_AT_LEAST_32_CHARS

# --- Server ----------------------------------------------------------------
PORT=8787
NODE_ENV=development
# Comma-separated browser origins allowed for CORS and the WebSocket Origin check.
PUBLIC_ORIGINS=http://localhost:5173

# SPEC §11 R190: how many X-Forwarded-For entries, counted from the RIGHT, this deployment's own
# proxies write. The per-IP limits (§9.4 step 3, R157) key on the entry that many places from the
# right; everything to its left was written by the caller and is ignored. Optional, 0 to 5,
# default 0: the header is ignored and every request is keyed on the socket's peer address, which
# is right for a local server with no proxy in front (with none, the header is whatever the caller
# wrote). Behind a proxy, set it to the `fewestEntries` that the server's `api.forwarded_for` log
# line shows for a request of your own sent with no X-Forwarded-For (render.yaml starts at 1), and
# never above the lowest count any request showed (docs/architecture.md §10, step 8).
TRUSTED_PROXY_HOPS=0

# The catalog version this server accepts. Must equal the value stamped on public.cards by
# `pnpm --filter @jackioh/server db:seed-catalog` and the version the client sends with every
# loadout save and queue request (§9.4).
CATALOG_VERSION=core-1

# BUILD M8's test-server mode: fixture accounts and seeded games. Refused in production.
E2E=0
