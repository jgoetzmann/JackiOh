{
  // e2e is deliberately self-contained: it type-checks without packages/* or apps/* being
  // buildable, because M8 is written before the client and server are finished. The only places
  // that touch engine or client source are support/tasks/replay-runner.ts and
  // support/tasks/lessons-runner.ts, which run under tsx from the repo root and are excluded from
  // this project.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["cypress", "node"],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["cypress.config.ts", "support/**/*.ts", "cypress/**/*.ts"],
  "exclude": ["support/tasks/replay-runner.ts", "support/tasks/lessons-runner.ts", "node_modules"]
}
